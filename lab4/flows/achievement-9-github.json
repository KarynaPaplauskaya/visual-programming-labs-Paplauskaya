        "jsCode": "// Получаем весь список репозиториев от GitHub\nconst repos = $input.all();\n\n// Считаем их количество\nconst totalRepos = repos.length;\n\n// Берем имя владельца из первого репозитория (так как оно у всех одинаковое)\nconst ownerName = repos.length > 0 ? repos[0].json.owner.login : \"Unknown\";\n\n// Возвращаем красивый объект\nreturn [{\n  json: {\n    message: `Привет, ${ownerName}! Я нашел ${totalRepos} репозиториев. Первый из них называется: ${repos[0].json.name}`,\n    repositories: repos.map(item => item.json.name) // Создаем массив только из названий\n  }\n}];"
