        "jsCode": "// 1. Объявляем массив с именами\nconst names = [\"Karina\", \"Alex\", \"Max\"];\n\n// 2. Создаем пустой массив для результатов\nlet results = [];\n\n// 3. Используем цикл for для перебора массива\nfor (let i = 0; i < names.length; i++) {\n  let currentName = names[i];\n  \n  // 4. Используем if/else для проверки длины имени\n  if (currentName.length > 4) {\n    // Создаем объект и добавляем в массив\n    results.push({ name: currentName, status: \"Long name\" });\n  } else {\n    results.push({ name: currentName, status: \"Short name\" });\n  }\n}\n\n// 5. Возвращаем объект с полем payload, как требует задание\nreturn [{\n  json: {\n    payload: results\n  }\n}];"
