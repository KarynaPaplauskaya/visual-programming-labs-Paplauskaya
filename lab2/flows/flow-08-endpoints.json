    {
        "id": "08bce7cdf71d8d7b",
        "type": "function",
        "z": "1bc49b723276fc76",
        "name": "function 5",
        "func": "let id = msg.req.params.id;\nlet limit = msg.req.query.limit;\n\n// Проверка: id должен быть числом\nif (isNaN(id)) {\n    msg.statusCode = 400;\n    msg.payload = {\n        error: \"Bad Request\",\n        message: \"id must be a number\",\n        received: id\n    };\n    return msg;\n}\n\nid = Number(id);\n\n// Проверка: id должен быть в диапазоне 1..3\nif (id < 1 || id > 3) {\n    msg.statusCode = 404;\n    msg.payload = {\n        error: \"Not Found\",\n        message: \"item not found\",\n        id: id\n    };\n    return msg;\n}\n\n// Успех: возвращаем item\nmsg.statusCode = 200;\nmsg.payload = {\n    id: id,\n    name: \"Item \" + id,\n    limit: limit || \"not specified\",\n    timestamp: new Date().toISOString()\n};\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\nreturn msg;",
        "outputs": 1,
